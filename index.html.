
<!DOCTYPE html>
<html lang="et">
<head>
<meta charset="UTF-8">
<meta name="viewport" content="width=device-width, initial-scale=1">
<meta name="theme-color" content="#ffffff">
<title>NEXORA | Fashion Outlet</title>
<style>
*{box-sizing:border-box}
html{scroll-behavior:smooth}
body{margin:0;color:#101010;font-family:Arial,Helvetica,sans-serif;background:#fff}
a{color:inherit;text-decoration:none}
button,input,select{font:inherit}
.announcement{background:#111;color:#fff;text-align:center;padding:9px;font-size:10px;letter-spacing:1.5px}
header{height:72px;padding:0 5%;display:grid;grid-template-columns:1fr auto 1fr;align-items:center;border-bottom:1px solid #eee;position:sticky;top:0;background:#fff;z-index:10}
.logo{font-size:20px;font-weight:900;letter-spacing:4px;text-align:center}
.nav{display:flex;gap:20px;font-size:11px;text-transform:uppercase;letter-spacing:1px}
.actions{text-align:right}
.actions button{border:0;background:none;cursor:pointer;font-size:13px}
.hero{width:92%;margin:22px auto 40px;min-height:330px;display:flex;align-items:center;padding:40px;color:white;background:linear-gradient(90deg,#000b,#0002),url('https://images.unsplash.com/photo-1483985988355-763728e1935b?auto=format&fit=crop&w=1800&q=85') center/cover}
.hero small{letter-spacing:3px;font-size:10px}
.hero h1{font-size:clamp(40px,7vw,70px);line-height:.95;margin:15px 0}
.hero p{font-size:13px;line-height:1.6}
.pill{display:inline-block;background:white;color:#111;padding:14px 25px;border-radius:30px;font-size:11px;font-weight:bold;margin-top:12px}
.wrap{width:92%;max-width:1400px;margin:0 auto 55px}
.heading{display:flex;justify-content:space-between;align-items:end;margin-bottom:20px}
.heading h2{font-size:30px;margin:0}
.heading p{font-size:12px;color:#777}
.categories{display:grid;grid-template-columns:repeat(4,1fr);gap:14px}
.category{background:#f6f6f6;padding:28px 12px;text-align:center;border:1px solid #eee;cursor:pointer}
.category strong{display:block;font-size:16px}
.category span{display:block;color:#777;font-size:11px;margin-top:7px}
.controls{display:flex;gap:10px;margin:20px 0}
.controls input,.controls select{height:43px;padding:0 12px;border:1px solid #ddd;background:#fff;min-width:0}
.controls input{flex:1}
.controls select{width:190px}
.grid{display:grid;grid-template-columns:repeat(4,minmax(0,1fr));gap:28px 14px}
.card{min-width:0}
.image{position:relative;aspect-ratio:4/5;background:#f5f5f5;overflow:hidden}
.image img{width:100%;height:100%;object-fit:cover;display:block}
.sale{position:absolute;top:10px;left:10px;background:white;padding:6px 9px;border-radius:18px;font-size:10px}
.brandline{font-size:10px;letter-spacing:1px;color:#777;margin-top:11px}
.name{font-size:13px;text-transform:uppercase;margin:6px 0;line-height:1.4}
.price{font-size:13px;font-weight:bold}
.old{font-weight:normal;color:#888;text-decoration:line-through;margin-left:7px}
.add{width:100%;height:40px;background:#111;color:white;border:1px solid #111;margin-top:11px;font-size:10px;letter-spacing:1px;cursor:pointer}
footer{background:#111;color:white;padding:38px 5%;font-size:11px;line-height:1.7}
.overlay{display:none;position:fixed;inset:0;background:#0007;z-index:30}
.overlay.show{display:block}
.drawer{height:100%;width:min(430px,92vw);margin-left:auto;background:white;padding:22px;overflow:auto}
.drawerhead{display:flex;justify-content:space-between;border-bottom:1px solid #eee;padding-bottom:16px}
.drawerhead button{border:0;background:none;font-size:22px}
.cartitem{display:flex;gap:12px;padding:15px 0;border-bottom:1px solid #eee}
.cartitem img{width:75px;height:90px;object-fit:cover}
.cartitem small{display:block;color:#777;margin:7px 0}
.qty{display:flex;align-items:center;gap:10px}
.qty button{background:white;border:1px solid #ddd;padding:4px 9px}
.total{display:flex;justify-content:space-between;margin:22px 0;font-weight:bold}
.checkout{width:100%;padding:15px;background:#111;color:white;border:0;font-size:11px}
@media(max-width:760px){
 header{height:65px;padding:0 4%}
 .nav{gap:9px}
 .nav a:nth-child(n+2){display:none}
 .logo{font-size:16px;letter-spacing:2px}
 .hero{min-height:270px;padding:24px}
 .categories{grid-template-columns:repeat(2,1fr);gap:10px}
 .category{padding:23px 8px}
 .heading h2{font-size:25px}
 .heading p{display:none}
 .grid{grid-template-columns:repeat(2,minmax(0,1fr));gap:22px 10px}
 .controls{flex-wrap:wrap}
 .controls input{flex-basis:100%}
 .controls select{flex:1;width:auto}
}
</style>
</head>
<body>

<div class="announcement">NEW ARRIVALS · CLOTHING · SNEAKERS · FRAGRANCE</div>

<header>
<nav class="nav">
<a href="#products">New in</a>
<a href="#collections">Collections</a>
<a href="#products">Sale</a>
</nav>
<a class="logo" href="#">NEXORA</a>
<div class="actions">
<button onclick="openCart()">BAG (<span id="count">0</span>)</button>
</div>
</header>

<section class="hero">
<div>
<small>THE NEW SEASON EDIT</small>
<h1>FIND YOUR<br>EVERYDAY STYLE.</h1>
<p>Avasta riided, jalanõud, aksessuaarid ja lõhnad ühest kohast.</p>
<a class="pill" href="#products">SHOP COLLECTION →</a>
</div>
</section>

<section class="wrap" id="collections">
<div class="heading">
<h2>Shop by collection</h2>
<p>Explore the edit</p>
</div>
<div class="categories">
<div class="category" onclick="choose('Clothing')"><strong>Clothing</strong><span>Riided</span></div>
<div class="category" onclick="choose('Footwear')"><strong>Footwear</strong><span>Jalanõud</span></div>
<div class="category" onclick="choose('Accessories')"><strong>Accessories</strong><span>Aksessuaarid</span></div>
<div class="category" onclick="choose('Fragrances')"><strong>Fragrances</strong><span>Lõhnad</span></div>
</div>
</section>

<section class="wrap" id="products">
<div class="heading">
<h2>Featured products</h2>
<p id="countText">Selected pieces</p>
</div>
<div class="controls">
<input id="search" type="search" placeholder="Search products..." oninput="render()">
<select id="category" onchange="render()">
<option value="All">All categories</option>
<option>Clothing</option>
<option>Footwear</option>
<option>Accessories</option>
<option>Fragrances</option>
</select>
<select id="sort" onchange="render()">
<option value="featured">Featured</option>
<option value="low">Price: low to high</option>
<option value="high">Price: high to low</option>
</select>
</div>
<div class="grid" id="grid"></div>
</section>

<footer>
<b style="letter-spacing:4px;font-size:20px">NEXORA</b>
<p>Fashion · Footwear · Accessories</p>
<p>Toodete saadavus, müüja andmed, tarne- ja tagastustingimused ning maksevõimalused avaldatakse enne tellimuste avamist.</p>
</footer>

<div class="overlay" id="overlay" onclick="if(event.target===this)closeCart()">
<aside class="drawer">
<div class="drawerhead">
<b>YOUR BAG</b>
<button onclick="closeCart()">×</button>
</div>
<div id="cartItems"></div>
<div class="total"><span>Total</span><span id="total">€0.00</span></div>
<button class="checkout" onclick="alert('Checkout ei ole veel aktiveeritud.')">CHECKOUT</button>
</aside>
</div>

<script>
// Lisa ja muuda tooteid siin.
// Pildiks pane enda või tarnija loal kasutatav pildi URL.
const products=[
{id:1,brand:"NEXORA EDIT",name:"Relaxed fit hoodie",cat:"Clothing",price:34.99,old:59.99,img:"https://images.unsplash.com/photo-1556821840-3a63f95609a7?auto=format&fit=crop&w=850&q=85"},
{id:2,brand:"NEXORA EDIT",name:"Classic low sneakers",cat:"Footwear",price:54.99,old:79.99,img:"https://images.unsplash.com/photo-1542291026-7eec264c27ff?auto=format&fit=crop&w=850&q=85"},
{id:3,brand:"NEXORA EDIT",name:"Puffer jacket",cat:"Clothing",price:79.99,old:119.99,img:"https://images.unsplash.com/photo-1544923246-77307dd654cb?auto=format&fit=crop&w=850&q=85"},
{id:4,brand:"NEXORA EDIT",name:"Minimal steel watch",cat:"Accessories",price:39.99,old:64.99,img:"https://images.unsplash.com/photo-1524592094714-0f0654e20314?auto=format&fit=crop&w=850&q=85"},
{id:5,brand:"NEXORA EDIT",name:"Amber fragrance",cat:"Fragrances",price:29.99,old:44.99,img:"https://images.unsplash.com/photo-1541643600914-78b084683601?auto=format&fit=crop&w=850&q=85"},
{id:6,brand:"NEXORA EDIT",name:"Essential cotton tee",cat:"Clothing",price:19.99,old:29.99,img:"https://images.unsplash.com/photo-1521572163474-6864f9cf17ab?auto=format&fit=crop&w=850&q=85"},
{id:7,brand:"NEXORA EDIT",name:"Retro runner",cat:"Footwear",price:49.99,old:69.99,img:"https://images.unsplash.com/photo-1542291026-7eec264c27ff?auto=format&fit=crop&w=850&q=85"},
{id:8,brand:"NEXORA EDIT",name:"Silver chain necklace",cat:"Accessories",price:24.99,old:39.99,img:"https://images.unsplash.com/photo-1611591437281-460bfbe1220a?auto=format&fit=crop&w=850&q=85"}
];

let cart=[];
const money=n=>"€"+n.toFixed(2);

function render(){
const q=document.getElementById('search').value.toLowerCase();
const c=document.getElementById('category').value;
const s=document.getElementById('sort').value;
let list=products.filter(p=>(c==="All"||p.cat===c)&&(p.name+" "+p.brand+" "+p.cat).toLowerCase().includes(q));
if(s==="low")list.sort((a,b)=>a.price-b.price);
if(s==="high")list.sort((a,b)=>b.price-a.price);
document.getElementById('countText').textContent=list.length+" products";
document.getElementById('grid').innerHTML=list.map(p=>`
<article class="card">
<div class="image">
<span class="sale">SALE</span>
<img src="${p.img}" alt="${p.name}" onerror="this.src='https://placehold.co/600x750/f3f3f3/555?text=Product'">
</div>
<div class="brandline">${p.brand}</div>
<div class="name">${p.name}</div>
<div class="price">${money(p.price)} <span class="old">${money(p.old)}</span></div>
<button class="add" onclick="add(${p.id})">ADD TO BAG</button>
</article>`).join('');
}

function choose(c){
document.getElementById('category').value=c;
render();
document.getElementById('products').scrollIntoView({behavior:'smooth'});
}

function add(id){
let x=cart.find(i=>i.id===id);
if(x)x.qty++;
else cart.push({id,qty:1});
updateCart();
}

function updateCart(){
document.getElementById('count').textContent=cart.reduce((n,x)=>n+x.qty,0);
document.getElementById('cartItems').innerHTML=cart.length?cart.map(x=>{
let p=products.find(y=>y.id===x.id);
return `<div class="cartitem">
<img src="${p.img}" alt="">
<div style="flex:1">
<b>${p.name}</b>
<small>${money(p.price)}</small>
<div class="qty">
<button onclick="changeQty(${p.id},-1)">−</button>
${x.qty}
<button onclick="changeQty(${p.id},1)">+</button>
</div>
</div>
</div>`;
}).join(''):'<p style="color:#777;padding:20px 0">Your bag is empty.</p>';
document.getElementById('total').textContent=money(cart.reduce((n,x)=>n+products.find(p=>p.id===x.id).price*x.qty,0));
}

function changeQty(id,d){
let x=cart.find(i=>i.id===id);
if(!x)return;
x.qty+=d;
if(x.qty<1)cart=cart.filter(i=>i.id!==id);
updateCart();
}

function openCart(){
document.getElementById('overlay').classList.add('show');
updateCart();
}

function closeCart(){
document.getElementById('overlay').classList.remove('show');
}

render();
updateCart();
</script>
</body>
</html>
